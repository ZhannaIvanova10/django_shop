# Database settings
# Для PostgreSQL:
DB_ENGINE=django.db.backends.postgresql
DB_NAME=your_database_name
DB_USER=your_database_user
DB_PASSWORD=your_database_password
DB_HOST=localhost
DB_PORT=5432

# Для SQLite:
# DB_ENGINE=django.db.backends.sqlite3
# DB_NAME=db.sqlite3

# Django secret key
SECRET_KEY=your-secret-key-here

# Debug mode
DEBUG=True
